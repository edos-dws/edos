# Copy to .env and fill. .env is gitignored. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://edos:edos@localhost:5432/edos
REDIS_URL=redis://localhost:6379/0

# --- LLM provider (go-live) ---
# Which vendor the Model Router uses. "gemini" (default) or "anthropic". "stub" forces the offline provider.
# If the OTHER vendor's key is also set, it is used automatically as the cross-vendor fallback.
EDOS_PROVIDER=gemini

# Provide the key for the vendor selected above. This is the ONLY thing left for go-live.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Model IDs per tier (optional overrides). Confirm the exact Gemini strings against your account.
# GEMINI_FRONTIER_MODEL=gemini-2.5-pro
# GEMINI_STANDARD_MODEL=gemini-2.5-flash
# GEMINI_LIGHTWEIGHT_MODEL=gemini-2.5-flash
# ANTHROPIC_FRONTIER_MODEL=claude-opus-4-8
# ANTHROPIC_STANDARD_MODEL=claude-sonnet-5
# ANTHROPIC_LIGHTWEIGHT_MODEL=claude-haiku-4-5

# Per-call output-token ceiling (safety cap).
# EDOS_LLM_MAX_OUTPUT_TOKENS=8000
