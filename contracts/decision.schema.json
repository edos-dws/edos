{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "edos.decision.v1",
  "title": "EDOS Decision Output",
  "description": "LOCKED contract. The single canonical shape the Decision Engine must emit and the Verification Engine and DB must consume. Reconciles roadmap Ch 6 and Ch 16. Do not change field names/types without a contract-change ticket that updates every consumer + tests in the same commit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "recommendation", "confidence", "status", "evidence"],
  "properties": {
    "schema_version": { "type": "string", "const": "edos.decision.v1" },
    "decision_id": { "type": "string", "description": "Stable id; assigned by software, not the LLM." },
    "summary": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "type": "string", "enum": ["proposed", "recommended", "verified", "frozen"] },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "confidence"],
        "properties": {
          "statement": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "risk_if_wrong": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "severity", "likelihood"],
        "properties": {
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "likelihood": { "type": "string", "enum": ["low", "medium", "high"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "benefit", "drawback"],
        "properties": {
          "option": { "type": "string" },
          "benefit": { "type": "string" },
          "drawback": { "type": "string" }
        }
      }
    },
    "affected_decisions": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source"],
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string", "description": "project-knowledge ref or external source id" },
          "kind": { "type": "string", "enum": ["fact", "assumption", "inference", "external"] }
        }
      }
    },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "freeze_blockers": {
      "type": "array",
      "description": "Reasons this decision must NOT be auto-frozen yet (e.g. unverified assumption below floor). Empty => no blocker. The freeze gate requires this to be empty.",
      "items": { "type": "string" }
    }
  }
}
