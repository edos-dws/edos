{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "edos.context_package.v1",
  "title": "EDOS Context Package",
  "description": "LOCKED contract. The deterministic, pre-assembled evidence package the Context Engine (Ch 5/15) builds and hands to the Decision Engine. The LLM NEVER retrieves context itself; it reasons only over this. Do not change without a contract-change ticket.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "intent", "items"],
  "properties": {
    "schema_version": { "type": "string", "const": "edos.context_package.v1" },
    "project_id": { "type": "string" },
    "intent": { "type": "string" },
    "entities": { "type": "array", "items": { "type": "string" } },
    "items": {
      "type": "array",
      "description": "Ranked context items (Ch 15 scoring). Highest score first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "content", "score"],
        "properties": {
          "type": { "type": "string", "enum": ["project", "requirement", "decision", "assumption", "risk", "document", "external"] },
          "ref_id": { "type": "string" },
          "content": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "external_used": { "type": "boolean" },
    "token_estimate": { "type": "integer", "minimum": 0 }
  }
}
